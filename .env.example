# ============================================================
# NexaStudy — Configuration File (.env.example)
# ============================================================
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env
#
# Then add your Gemini API key from:
#   https://aistudio.google.com/app/apikey
# ============================================================

# --- LLM API Key (required) ---------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# --- ChromaDB Vector Store ----------------------------------
CHROMA_PERSIST_DIR=./chroma_db
COLLECTION_NAME=student_rag
FEEDBACK_COLLECTION=rag_feedback
MEMORY_COLLECTION=rag_memory

# --- Model Selection ----------------------------------------
EMBEDDING_MODEL=models/gemini-embedding-001
GENERATION_MODEL=models/gemini-flash-lite-latest
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- RAG Retrieval Tuning -----------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K_RETRIEVAL=10
TOP_K_RERANKED=4

# --- Memory & OCR -------------------------------------------
MAX_MEMORY_TURNS=10
OCR_MIN_TEXT_THRESHOLD=40
